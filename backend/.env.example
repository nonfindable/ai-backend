# ─────────────────────────────────────────────────────────────
# start.ai — backend configuration
# Copy this file to ".env" and adjust. Real environment variables
# always override values set here.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Chat-completions API. The gateway speaks the OpenAI wire format, so any
# OpenAI-compatible provider works by changing OPENAI_BASE_URL and the model
# names — the variables keep the OPENAI_ prefix for compatibility.
#
# LIVE mode needs BOTH of the following; if either is missing the app runs in
# MOCK mode, returning realistic canned plans end-to-end at zero cost.
#   AI_LIVE=true            master switch
#   OPENAI_API_KEY=...      a real key (sk-... for OpenAI, gsk_... for Groq)
# Set AI_LIVE=false to force MOCK while leaving a key parked in this file — the
# key is then never sent anywhere. The startup log prints which mode won, and
# GET /api/meter confirms it: callsTotal only climbs when calls are really made.
AI_LIVE=true
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Groq (OpenAI-compatible) --- to use Groq instead of OpenAI, set:
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL_FAST=llama-3.1-8b-instant
#   OPENAI_MODEL_SMART=llama-3.3-70b-versatile
# With the gpt-oss reasoning models, also set AI_REASONING_EFFORT=low (below).
#
# Groq rate limits are PER MODEL, so pointing FAST and SMART at the same model
# makes both share one daily allowance. Splitting them gives each stage its own:
#   OPENAI_MODEL_FAST=llama-3.1-8b-instant     understand + intake
#   OPENAI_MODEL_SMART=openai/gpt-oss-120b     confirm + plan
# The fast model handles far more calls (one per interview question), so this
# is where most of the budget goes. Check the JSON still parses after switching:
# smaller models follow a strict output shape less reliably.

# Response size. The plan stage emits a large JSON object, and a reasoning model
# spends part of its output budget thinking before it writes any of it. Groq's
# default cap for openai/gpt-oss-120b is 3072 tokens, of which ~2300 went on
# reasoning — the plan JSON was then cut off mid-object and came back as
# "400 json_validate_failed" with an empty failed_generation. Set 0 to omit the
# parameter and use whatever the provider defaults to.
AI_MAX_COMPLETION_TOKENS=8192

# Reasoning models (gpt-oss, o-series) accept "reasoning_effort": low|medium|high.
# On openai/gpt-oss-120b, "low" cut reasoning from ~2300 tokens to ~220 with no
# loss of plan quality — roughly halving the tokens each plan costs, which
# matters on a free tier with an 8000 tokens-per-minute limit.
# Leave EMPTY for models that reject the parameter (gpt-4o, llama-3.x).
AI_REASONING_EFFORT=

# HTTP server
PORT=8080
# Leave blank when the backend also serves the frontend (same origin).
# A value of * lets ANY website call this API on a signed-in user's behalf.
CORS_ALLOW_ORIGIN=

# AI gateway — protects the single shared API account from unpredictable load.
AI_DAILY_CALLS_PER_USER=40
# On a small per-minute token allowance, concurrency works against you: four
# simultaneous calls at ~2000 tokens each exceed an 8000 TPM limit on their own,
# so the account throttles itself. Lower this to 1-2 on a free tier. A throttled
# call is no longer lost — the gateway reads the provider's "try again in Ns"
# and waits that long (up to 30s) instead of retrying on its own faster
# schedule — but waiting is still slower than not being throttled.
AI_MAX_CONCURRENCY=4
AI_MONTHLY_USD_CAP=50

# Storage — JSON snapshot lives here (created automatically).
DATA_DIR=./data

# Serve the static frontend at "/" for a one-command local run.
# Set empty to run the API only (frontend served separately).
FRONTEND_DIR=../frontend

# Missed-day rollover job. 1440 = nightly. Lower it to test rollover quickly.
ROLLOVER_INTERVAL_MINUTES=1440

# Timezone assigned to new users when the client does not send one. All plan
# dates, rollover and .ics export are computed in the user's own zone.
DEFAULT_TIMEZONE=Asia/Tashkent

# Authentication. POST /api/session returns a bearer token; send it back as
# "Authorization: Bearer <token>" on every other /api route.
# Setting this to true additionally accepts a bare X-User-Id header as identity,
# which is NOT authentication — local demos only, never production.
ALLOW_HEADER_AUTH=false
